{
  "name": "vite-plugin-css-props",
  "type": "module",
  "version": "0.1.1",
  "description": "A Vite plugin to generate JS/CSS/SCSS bindings and .d.ts for CSS Custom Properties from a single config file",
  "author": "loocus",
  "license": "MIT",
  "homepage": "https://github.com/loocus/vite-plugins#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/loocus/vite-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/loocus/vite-plugins/issues"
  },
  "keywords": [
    "vite",
    "plugin",
    "css-custom-properties",
    "css-variables",
    "scss",
    "sass",
    "dark-mode",
    "design-tokens",
    "virtual-module"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "sass": ">=1.79.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "dependencies": {
    "colord": "^2.9.3",
    "esbuild": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "sass": "^1.80.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
